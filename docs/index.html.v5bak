      const states=ctx.rng.int(3,8);
      n.body.unshift(raw(`local ${stateVar}=${ctx.rng.int(1,states)}`));
      n.body.unshift(raw(`while ${stateVar}~=0 do if ${stateVar}==1 then elseif ${stateVar}==2 then end break end -- TT-57 Kleene flatten`));
      n._gungnir_skip=true;
    }
  });
});

