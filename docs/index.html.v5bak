// ============================================================
// ORCHESTRATOR & VERIFICATION
// ============================================================
class Orchestrator{
  constructor(config){ this.config=config||{}; this.rng=new RNG(config.seed||Date.now()); this.stats={}; this.enabled=new Set(); }
  setEnabled(ids){ this.enabled=new Set(ids); }
  obfuscate(ast){
    this.stats={nodesProcessed:0,startTime:Date.now()};
    const enabled=TECHNIQUES.filter(t=>this.enabled.has(t.id));
    for(const tech of enabled){
      try{ tech.fn(ast,{rng:this.rng,stats:this.stats,intensity:this.config.intensity||10}); }
      catch(e){ console.warn('Technique '+tech.id+' failed:',e.message); }
    }
    // Syntax repair: remove statements after return
    this.repairReturns(ast);
    this.stats.endTime=Date.now();
    return ast;
  }
  repairReturns(node){
    const stack=[node];
    const visited=new Set();
    while(stack.length>0){
      const n=stack.pop();
      if(!n||typeof n!=='object'||visited.has(n))continue;
      visited.add(n);
      if(Array.isArray(n.body)){
        for(let i=0;i<n.body.length;i++){
          if(n.body[i]&&n.body[i].type==='ReturnStatement'&&i<n.body.length-1){
            n.body.length=i+1; break;
          }
        }
      }
      for(const k in n){
        if(k==='body')continue;
        const v=n[k];
        if(Array.isArray(v)) v.forEach(c=>{if(c&&typeof c==='object'&&c.type)stack.push(c)});
        else if(v&&typeof v==='object'&&v.type) stack.push(v);
      }
    }
  }
}

class Verifier{
  verify(code,stats){
    const results={};
    // 1. Syntax validation
    try{ new Parser(new Lexer(code).tok()).chunk(); results.syntax={pass:true,msg:'Lua 5.1 syntax valid'}; }
    catch(e){ results.syntax={pass:false,msg:e.message}; }
    // 2. Feature detection
    const features={
      vmLoop:/while\s+\w+\s*<=/.test(code),
      stateMachine:/_state_|_mixed_state_/.test(code),
      metatables:(code.match(/setmetatable/g)||[]).length,
      coroutines:(code.match(/coroutine\./g)||[]).length,
      antiDebug:(code.match(/debug\./g)||[]).length,
      opaquePredicates:(code.match(/#\(\{/g)||[]).length,
      mbaExpressions:(code.match(/\^\s*#|#\(\{/g)||[]).length,
      stringEncryption:/_dec_|string\.byte/.test(code),
      pcallWrapping:(code.match(/pcall/g)||[]).length,
    };
    results.features=features;
    // 3. Strength score
    let strength=0;
    if(features.vmLoop)strength+=15; if(features.stateMachine)strength+=12;
    if(features.metatables>0)strength+=Math.min(features.metatables*3,15);
    if(features.coroutines>0)strength+=Math.min(features.coroutines*2,10);
    if(features.antiDebug>0)strength+=Math.min(features.antiDebug*2,10);
    if(features.opaquePredicates>0)strength+=Math.min(features.opaquePredicates*0.5,15);
    if(features.mbaExpressions>0)strength+=Math.min(features.mbaExpressions*0.3,10);
    if(features.stringEncryption)strength+=10;
    if(features.pcallWrapping>0)strength+=Math.min(features.pcallWrapping,8);
    results.strength=Math.min(100,strength);
    // 4. Technique coverage
    results.coverage={total:TECHNIQUES.length,enabled:stats.enabledCount||0};
    results.overall=results.syntax.pass&&results.strength>=50;
    return results;
  }
}

// ============================================================
// UI LOGIC
// ============================================================
const TECH_GROUPS=[
  {name:'第一编：多态虚拟机引擎',prefix:'VM',count:22},
  {name:'第二编：炼狱级控制流混淆',prefix:'CF',count:20},
  {name:'第三编：量子级数据与常量混淆',prefix:'DC',count:18},
  {name:'第四编：多维作用域与符号撕裂',prefix:'SC',count:11},
  {name:'第五编：反自动化分析护盾',prefix:'AA',count:8},
  {name:'第六编：硬核运行时反制',prefix:'RT',count:12},
  {name:'第七编：平台专属(Delta)',prefix:'PL',count:8},
  {name:'第八编：交付与工程',prefix:'DE',count:9},
  {name:'第九编：终极强化技术',prefix:'TT',count:28},
  {name:'第十编：前沿突破技术',prefix:'TT-29+',count:22},
];
let logLines=0;
let lastReport=null;

function log(msg,type='info'){
  const el=document.getElementById('logContent');
  const div=document.createElement('div');
  div.className='log-line log-'+type;
  div.textContent='['+new Date().toLocaleTimeString()+'] '+msg;
  el.appendChild(div);
  el.scrollTop=el.scrollHeight;
  logLines++;
  document.getElementById('logCount').textContent=logLines+' 条';
}

function buildTechPanel(){
  const panel=document.getElementById('techPanel');
  panel.innerHTML='';
  for(const group of TECH_GROUPS){
    const det=document.createElement('details');
    det.className='tech-group';
    det.open=false;
    const techs=TECHNIQUES.filter(t=>{
      if(group.prefix==='TT-29+')return t.id.startsWith('TT-')&&parseInt(t.id.split('-')[1])>=29;
      return t.id.startsWith(group.prefix+'-');
    });
    det.innerHTML='<summary>'+group.name+' <span class="count">'+techs.length+'项</span></summary>';
    for(const tech of techs){
      const label=document.createElement('label');
      label.className='tech-item enabled';
      label.innerHTML='<input type="checkbox" checked value="'+tech.id+'"> '+tech.id+' '+tech.name;
      label.querySelector('input').addEventListener('change',function(){
        label.classList.toggle('enabled',this.checked);
      });
      det.appendChild(label);
    }
    panel.appendChild(det);
  }
}

function getEnabledTechs(){
  return Array.from(document.querySelectorAll('#techPanel input:checked')).map(i=>i.value);
}

function selectAll(val){
  document.querySelectorAll('#techPanel input').forEach(i=>{
    i.checked=val;
    i.closest('.tech-item').classList.toggle('enabled',val);
  });
}

function selectPreset(mode){
  if(mode==='max') selectAll(true);
}

function loadSample(){
  document.getElementById('inputCode').value=`-- Gungnir 测试脚本
local function add(a, b)
  return a + b
end
local function mul(a, b)
  return a * b
end
local function factorial(n)
  if n <= 1 then return 1 end
  return n * factorial(n - 1)
end
local x = 10
local y = 20
local result1 = add(x, y)
local result2 = mul(x, y)
local result3 = factorial(5)
print("Results:", result1, result2, result3)
for i = 1, 10 do
  print("Loop:", i)
end`;
  updateInputStats();
}

function updateInputStats(){
  const code=document.getElementById('inputCode').value;
  document.getElementById('inputStats').textContent=code.length+' 字节 / '+code.split('\n').length+' 行';
}

function updateProgress(pct){
  document.getElementById('progressFill').style.width=pct+'%';
}

async function runObfuscation(){
  const input=document.getElementById('inputCode').value;
  if(!input.trim()){ log('错误：请先输入 Lua 源码','error'); return; }
  const btn=document.getElementById('obfuscateBtn');
  btn.disabled=true; btn.textContent='混淆中...';
  log('开始混淆处理...','info');
  updateProgress(10);
  try{
    // Parse
    const lexer=new Lexer(input);
    const tokens=lexer.tok();
    log('词法分析完成：'+tokens.length+' 个token','success');
    updateProgress(20);
    const parser=new Parser(tokens);
    const ast=parser.chunk();
    log('语法分析完成：AST构建成功','success');
    updateProgress(30);
    // Obfuscate
    const enabled=getEnabledTechs();
    log('启用技术：'+enabled.length+' / '+TECHNIQUES.length+' 项','tech');
    const orch=new Orchestrator({intensity:parseInt(document.getElementById('intensitySelect').value),seed:Date.now()});
    orch.setEnabled(enabled);
    orch.stats.enabledCount=enabled.length;
    const obfuscatedAst=orch.obfuscate(ast);
    log('混淆变换完成','success');
    updateProgress(70);
    // Generate
    const writer=new Writer();
    const output=writer.write(obfuscatedAst);
    log('代码生成完成：'+output.length+' 字节','success');
    updateProgress(85);
    // Verify
    if(document.getElementById('autoVerify').checked){
      const verifier=new Verifier();
      const result=verifier.verify(output,orch.stats);
      lastReport=result;
      if(result.syntax.pass) log('语法验证：通过 (Lua 5.1)','success');
      else log('语法验证：失败 - '+result.syntax.msg,'error');
      log('强度评分：'+result.strength+'/100',result.strength>=70?'success':'warn');
      log('特征检测：VM='+result.features.vmLoop+' 状态机='+result.features.stateMachine+' 元表='+result.features.metatables+' 协程='+result.features.coroutines,'info');
    }
    updateProgress(100);
    document.getElementById('outputCode').value=output;
    document.getElementById('outputStats').textContent=output.length+' 字节 / '+output.split('\n').length+' 行';
    log('混淆完成！','success');
  }catch(e){
    log('错误：'+e.message,'error');
    console.error(e);
  }
  btn.disabled=false; btn.textContent='🚀 开始混淆';
  setTimeout(()=>updateProgress(0),1000);
}

function downloadOutput(){
  const output=document.getElementById('outputCode').value;
  if(!output){ log('没有可下载的输出','warn'); return; }
  const blob=new Blob([output],{type:'text/plain'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
  a.download='gungnir_obfuscated_'+Date.now()+'.lua';
  a.click();
  log('输出已下载','success');
}

function copyOutput(){
  const output=document.getElementById('outputCode').value;
  if(!output){ log('没有可复制的输出','warn'); return; }
  navigator.clipboard.writeText(output).then(()=>log('已复制到剪贴板','success'));
}

function showReport(){
  if(!lastReport){ log('请先运行混淆以生成报告','warn'); return; }
  const r=lastReport;
  document.getElementById('reportBody').innerHTML=`
    <div class="stats-grid">
      <div class="stat-card"><div class="value">${r.overall?'✅':'❌'}</div><div class="label">总体状态</div></div>
      <div class="stat-card"><div class="value">${r.strength}</div><div class="label">强度评分/100</div></div>
      <div class="stat-card"><div class="value">${r.coverage.enabled}</div><div class="label">启用技术</div></div>
      <div class="stat-card"><div class="value">${r.coverage.total}</div><div class="label">总技术数</div></div>
    </div>
    <h3 style="color:#58a6ff;margin:12px 0 6px">语法验证</h3>
    <p style="font-size:13px;color:${r.syntax.pass?'#3fb950':'#f85149'}">${r.syntax.pass?'✅ 通过':'❌ '+r.syntax.msg}</p>
    <h3 style="color:#58a6ff;margin:12px 0 6px">特征检测</h3>
    <pre style="font-size:11px">VM解释器循环: ${r.features.vmLoop?'是':'否'}
状态机: ${r.features.stateMachine?'是':'否'}
元表使用: ${r.features.metatables} 处
协程使用: ${r.features.coroutines} 处
反调试: ${r.features.antiDebug} 处
不透明谓词: ${r.features.opaquePredicates} 处
MBA表达式: ${r.features.mbaExpressions} 处
字符串加密: ${r.features.stringEncryption?'是':'否'}
pcall包装: ${r.features.pcallWrapping} 处</pre>
  `;
  document.getElementById('reportModal').classList.add('active');
}

function closeReport(){ document.getElementById('reportModal').classList.remove('active'); }

// Init
document.getElementById('inputCode').addEventListener('input',updateInputStats);
buildTechPanel();
document.getElementById('techCount').textContent=TECHNIQUES.length;
log('Gungnir Web v5.0.0 初始化完成，共 '+TECHNIQUES.length+' 项混淆技术','success');
log('提示：点击"加载示例"可快速测试','info');
</script>
</body>
</html>
