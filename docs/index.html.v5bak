<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Gungnir - Lua 5.1 终极混淆器 v5.0.0 | 160+项技术</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Segoe UI',system-ui,sans-serif;background:#0a0e17;color:#e0e6ed;min-height:100vh}
.header{background:linear-gradient(135deg,#0d1117 0%,#161b22 100%);border-bottom:1px solid #30363d;padding:12px 20px;display:flex;align-items:center;justify-content:space-between}
.logo{font-size:22px;font-weight:700;background:linear-gradient(90deg,#58a6ff,#bc8cff);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.version{font-size:12px;color:#8b949e}
.version span{color:#58a6ff;font-weight:600}
.main{display:flex;height:calc(100vh - 52px)}
.sidebar{width:300px;background:#0d1117;border-right:1px solid #30363d;overflow-y:auto;padding:12px;flex-shrink:0}
.sidebar h3{font-size:13px;color:#8b949e;margin:12px 0 6px;text-transform:uppercase;letter-spacing:0.5px}
.tech-group{margin-bottom:8px}
.tech-group summary{cursor:pointer;font-size:12px;color:#c9d1d9;padding:4px 6px;background:#161b22;border-radius:4px;list-style:none;display:flex;justify-content:space-between;align-items:center}
.tech-group summary::-webkit-details-marker{display:none}
.tech-group summary:hover{background:#21262d}
.tech-group summary .count{color:#58a6ff;font-size:11px}
.tech-item{display:flex;align-items:center;padding:3px 6px 3px 20px;font-size:11px;color:#8b949e;cursor:pointer}
.tech-item:hover{color:#c9d1d9;background:#161b22;border-radius:3px}
.tech-item input{margin-right:6px;accent-color:#58a6ff}
.tech-item.enabled{color:#3fb950}
.content{flex:1;display:flex;flex-direction:column;overflow:hidden}
.toolbar{padding:10px 16px;background:#0d1117;border-bottom:1px solid #30363d;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.btn{padding:7px 16px;border:none;border-radius:6px;font-size:13px;cursor:pointer;font-weight:600;transition:all 0.2s}
.btn-primary{background:linear-gradient(135deg,#238636,#2ea043);color:#fff}
.btn-primary:hover{background:linear-gradient(135deg,#2ea043,#3fb950);transform:translateY(-1px)}
.btn-primary:disabled{opacity:0.5;cursor:not-allowed;transform:none}
.btn-secondary{background:#21262d;color:#c9d1d9;border:1px solid #30363d}
.btn-secondary:hover{background:#30363d}
select{background:#21262d;color:#c9d1d9;border:1px solid #30363d;border-radius:6px;padding:6px 10px;font-size:12px}
.editors{flex:1;display:flex;overflow:hidden}
.editor-panel{flex:1;display:flex;flex-direction:column;border-right:1px solid #30363d}
.editor-panel:last-child{border-right:none}
.editor-header{padding:6px 12px;background:#161b22;font-size:12px;color:#8b949e;display:flex;justify-content:space-between;align-items:center}
.editor-header .stats{color:#58a6ff;font-size:11px}
textarea{flex:1;background:#0d1117;color:#c9d1d9;border:none;padding:12px;font-family:'Consolas','Monaco',monospace;font-size:12px;line-height:1.6;resize:none;outline:none;tab-size:2}
textarea:focus{background:#0a0e17}
.log-panel{height:180px;background:#0d1117;border-top:1px solid #30363d;display:flex;flex-direction:column}
.log-header{padding:6px 12px;background:#161b22;font-size:12px;color:#8b949e;display:flex;justify-content:space-between;align-items:center}
.log-content{flex:1;overflow-y:auto;padding:8px 12px;font-family:'Consolas',monospace;font-size:11px;line-height:1.5}
.log-line{margin:1px 0}
.log-info{color:#58a6ff}
.log-success{color:#3fb950}
.log-warn{color:#d29922}
.log-error{color:#f85149}
.log-tech{color:#bc8cff}
.progress-bar{height:4px;background:#21262d;overflow:hidden}
.progress-fill{height:100%;background:linear-gradient(90deg,#58a6ff,#bc8cff,#3fb950);transition:width 0.3s;width:0%}
.modal{display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.7);z-index:1000;align-items:center;justify-content:center}
.modal.active{display:flex}
.modal-content{background:#0d1117;border:1px solid #30363d;border-radius:12px;padding:24px;max-width:600px;width:90%;max-height:80vh;overflow-y:auto}
.modal-content h2{color:#58a6ff;margin-bottom:16px;font-size:18px}
.modal-content pre{background:#161b22;padding:12px;border-radius:6px;font-size:11px;overflow-x:auto;white-space:pre-wrap;word-break:break-all}
.stats-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:12px 0}
.stat-card{background:#161b22;border:1px solid #30363d;border-radius:8px;padding:10px;text-align:center}
.stat-card .value{font-size:20px;font-weight:700;color:#58a6ff}
.stat-card .label{font-size:10px;color:#8b949e;margin-top:2px}
.close-modal{float:right;background:none;border:none;color:#8b949e;font-size:20px;cursor:pointer}
.close-modal:hover{color:#f85149}
::-webkit-scrollbar{width:6px;height:6px}
::-webkit-scrollbar-track{background:#0d1117}
::-webkit-scrollbar-thumb{background:#30363d;border-radius:3px}
::-webkit-scrollbar-thumb:hover{background:#484f58}
</style>
</head>
<body>
<div class="header">
  <div class="logo">⚔️ GUNGIR</div>
  <div class="version">v<span id="verNum">5.0.0</span> | <span id="techCount">160</span>+ 项混淆技术 | Lua 5.1 / Delta Executor</div>
</div>
<div class="progress-bar"><div class="progress-fill" id="progressFill"></div></div>
<div class="main">
  <div class="sidebar">
    <h3>混淆技术面板</h3>
    <div id="techPanel"></div>
    <h3>快速操作</h3>
    <button class="btn btn-secondary" style="width:100%;margin-bottom:6px" onclick="selectAll(true)">全选技术</button>
    <button class="btn btn-secondary" style="width:100%;margin-bottom:6px" onclick="selectAll(false)">全不选</button>
    <button class="btn btn-secondary" style="width:100%" onclick="selectPreset('max')">最大强度预设</button>
  </div>
  <div class="content">
    <div class="toolbar">
      <button class="btn btn-primary" id="obfuscateBtn" onclick="runObfuscation()">🚀 开始混淆</button>
      <button class="btn btn-secondary" onclick="loadSample()">📋 加载示例</button>
      <button class="btn btn-secondary" onclick="downloadOutput()">💾 下载输出</button>
      <button class="btn btn-secondary" onclick="copyOutput()">📋 复制输出</button>
      <button class="btn btn-secondary" onclick="showReport()">📊 验证报告</button>
      <select id="intensitySelect">
        <option value="1">强度 1 - 基础</option>
        <option value="3">强度 3 - 中等</option>
        <option value="5">强度 5 - 高级</option>
        <option value="8">强度 8 - 极限</option>
        <option value="10" selected>强度 10 - 理论极限</option>
      </select>
      <label style="font-size:12px;color:#8b949e"><input type="checkbox" id="autoVerify" checked> 自动验证</label>
    </div>
    <div class="editors">
      <div class="editor-panel">
        <div class="editor-header"><span>📝 输入 Lua 源码</span><span class="stats" id="inputStats">0 字节</span></div>
        <textarea id="inputCode" placeholder="在此粘贴 Lua 5.1 源码..." spellcheck="false"></textarea>
      </div>
      <div class="editor-panel">
        <div class="editor-header"><span>🔒 混淆输出</span><span class="stats" id="outputStats">等待混淆...</span></div>
        <textarea id="outputCode" readonly placeholder="混淆结果将显示在这里..." spellcheck="false"></textarea>
      </div>
    </div>
    <div class="log-panel">
      <div class="log-header"><span>📋 执行日志</span><span id="logCount">0 条</span></div>
      <div class="log-content" id="logContent"></div>
    </div>
  </div>
</div>

<div class="modal" id="reportModal">
  <div class="modal-content">
    <button class="close-modal" onclick="closeReport()">&times;</button>
    <h2>📊 Gungnir 验证报告</h2>
    <div id="reportBody"></div>
  </div>
</div>

<script>
// ============================================================
// GUNGNIR WEB EDITION v5.0.0 — 160+ Technique Lua 5.1 Obfuscator
// ============================================================

// ---------- RNG ----------
class RNG{constructor(s){this.s=s>>>0}next(){this.s=(this.s*1664525+1013904223)>>>0;return this.s/4294967296}int(a,b){return Math.floor(this.next()*(b-a+1))+a}pick(a){return a[Math.floor(this.next()*a.length)]}shuffle(a){for(let i=a.length-1;i>0;i--){const j=Math.floor(this.next()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a}bool(p=0.5){return this.next()<p}str(l){const c='abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789';let s='';for(let i=0;i<l;i++)s+=c[Math.floor(this.next()*c.length)];return s}}

// ---------- Lua 5.1 Lexer ----------
const KW=new Set(['and','break','do','else','elseif','end','false','for','function','if','in','local','nil','not','or','repeat','return','then','true','until','while']);
class Lexer{constructor(s){this.s=s;this.p=0;this.l=1;this.t=[]}peek(){return this.s[this.p]||''}adv(){const c=this.s[this.p++];if(c==='\n'){this.l++;this.c=1}else this.c++;return c}skip(){while(this.p<this.s.length){const c=this.peek();if(c===' '||c==='\t'||c==='\n'||c==='\r')this.adv();else if(c==='-'&&this.s[this.p+1]==='-'){this.adv();this.adv();if(this.peek()==='['&&this.s[this.p+1]==='['){this.adv();this.adv();let d=1;while(this.p<this.s.length&&d>0){if(this.peek()===']'&&this.s[this.p+1]===']'){d--;this.adv();this.adv()}else this.adv()}}else while(this.p<this.s.length&&this.peek()!=='\n')this.adv()}else break}}str(){const q=this.adv();let s='';while(this.p<this.s.length){const c=this.adv();if(c===q)break;if(c==='\\'){const n=this.adv();switch(n){case'n':s+='\n';break;case't':s+='\t';break;case'r':s+='\r';break;case'\\':s+='\\';break;case'"':s+='"';break;case"'":s+="'";break;case'0':s+='\0';break;default:s+='\\'+n}}else s+=c}return{type:'String',value:s}}num(){let s='';while(this.p<this.s.length&&/[0-9a-fA-F.xXpPeE]/.test(this.peek()))s+=this.adv();return{type:'Number',value:parseFloat(s)}}ident(){let s='';while(this.p<this.s.length&&/[a-zA-Z0-9_]/.test(this.peek()))s+=this.adv();return KW.has(s)?{type:'Keyword',value:s}:{type:'Identifier',value:s}}tok(){while(this.p<this.s.length){this.skip();if(this.p>=this.s.length)break;const c=this.peek();if(c==='"'||c==="'")this.t.push(this.str());else if(/[0-9]/.test(c))this.t.push(this.num());else if(/[a-zA-Z_]/.test(c))this.t.push(this.ident());else{let op=c;if((c==='='||c==='~'||c==='<'||c==='>')&&this.s[this.p+1]==='='){this.adv();op+=this.adv()}else if(c==='.'&&this.s[this.p+1]==='.'){op+=this.adv();this.adv();if(this.peek()==='.')op+=this.adv()}else this.adv();this.t.push({type:'Operator',value:op})}}this.t.push({type:'EOF'});return this.t}}

// ---------- Lua 5.1 Parser ----------
class Parser{constructor(t){this.t=t;this.i=0}peek(){return this.t[this.i]}cons(){return this.t[this.i++]}expect(ty,v){const t=this.cons();if(t.type!==ty||(v&&t.value!==v))throw new Error(`Expected ${ty}${v?' '+v:''}, got ${t.type} ${t.value}`);return t}chunk(){const b=[];while(this.peek().type!=='EOF'&&this.peek().value!=='else'&&this.peek().value!=='elseif'&&this.peek().value!=='end'&&this.peek().value!=='until')b.push(this.stmt());return{type:'Chunk',body:b}}stmt(){const t=this.peek();if(t.type==='Operator'&&t.value===';'){this.cons();return{type:'EmptyStatement'}}if(t.type==='Keyword'){switch(t.value){case'local':return this.local();case'if':return this.ifStmt();case'while':return this.whileStmt();case'for':return this.forStmt();case'repeat':return this.repeatStmt();case'function':return this.funcDecl(false);case'return':this.cons();return{type:'ReturnStatement',arguments:this.exprList()};case'break':this.cons();return{type:'BreakStatement'};case'do':this.cons();const b=this.chunk().body;this.expect('Keyword','end');return{type:'DoStatement',body:b}}}return this.exprStmt()}local(){this.expect('Keyword','local');if(this.peek().type==='Keyword'&&this.peek().value==='function'){this.cons();const n=this.expect('Identifier').value;const f=this.funcBody();return{type:'LocalFunctionStatement',identifier:{type:'Identifier',name:n},...f}}const names=[this.expect('Identifier').value];while(this.peek().value===','){this.cons();names.push(this.expect('Identifier').value)}let init=[];if(this.peek().value==='='){this.cons();init=this.exprList()}return{type:'LocalStatement',variables:names.map(n=>({type:'Identifier',name:n})),init}}ifStmt(){this.expect('Keyword','if');const cond=this.expr();this.expect('Keyword','then');const body=this.chunk().body;const clauses=[{condition:cond,body}];while(this.peek().value==='elseif'){this.cons();const c=this.expr();this.expect('Keyword','then');const b=this.chunk().body;clauses.push({condition:c,body:b})}let elseBody=null;if(this.peek().value==='else'){this.cons();elseBody=this.chunk().body}this.expect('Keyword','end');return{type:'IfStatement',clauses,else:elseBody}}whileStmt(){this.expect('Keyword','while');const cond=this.expr();this.expect('Keyword','do');const body=this.chunk().body;this.expect('Keyword','end');return{type:'WhileStatement',condition:cond,body}}forStmt(){this.expect('Keyword','for');const vn=this.expect('Identifier').value;if(this.peek().value==='='){this.cons();const st=this.expr();this.expect('Operator',',');const en=this.expr();let step=null;if(this.peek().value===','){this.cons();step=this.expr()}this.expect('Keyword','do');const body=this.chunk().body;this.expect('Keyword','end');return{type:'NumericForStatement',variable:{type:'Identifier',name:vn},start:st,end:en,step,body}}const names=[vn];while(this.peek().value===','){this.cons();names.push(this.expect('Identifier').value)}this.expect('Keyword','in');const iter=this.exprList();this.expect('Keyword','do');const body=this.chunk().body;this.expect('Keyword','end');return{type:'GenericForStatement',variables:names.map(n=>({type:'Identifier',name:n})),iterators:iter,body}}repeatStmt(){this.expect('Keyword','repeat');const body=this.chunk().body;this.expect('Keyword','until');const cond=this.expr();return{type:'RepeatStatement',body,condition:cond}}funcDecl(isL){if(!isL)this.expect('Keyword','function');const name=this.funcName();const f=this.funcBody();return isL?{type:'LocalFunctionStatement',identifier:name,...f}:{type:'FunctionDeclaration',identifier:name,...f}}funcName(){let name={type:'Identifier',name:this.expect('Identifier').value};while(this.peek().value==='.'){this.cons();name={type:'MemberExpression',object:name,property:{type:'Identifier',name:this.expect('Identifier').value}}}if(this.peek().value===':'){this.cons();name={type:'MemberExpression',object:name,property:{type:'Identifier',name:this.expect('Identifier').value},method:true}}return name}funcBody(){this.expect('Operator','(');const params=[];let isV=false;if(this.peek().value!==')'){if(this.peek().type==='Identifier'){params.push({type:'Identifier',name:this.cons().value});while(this.peek().value===','){this.cons();if(this.peek().value==='...'){isV=true;this.cons();break}params.push({type:'Identifier',name:this.cons().value})}}else if(this.peek().value==='...'){isV=true;this.cons()}}this.expect('Operator',')');const body=this.chunk().body;this.expect('Keyword','end');return{parameters:params,isVararg:isV,body}}exprStmt(){const e=this.expr();if(this.peek().value===','||(this.peek().value==='='&&e.type!=='CallExpression'&&e.type!=='MethodCallExpression')){if(this.peek().value===','){const t=[e];while(this.peek().value===','){this.cons();t.push(this.expr())}this.expect('Operator','=');const v=this.exprList();return{type:'AssignmentStatement',variables:t,init:v}}this.cons();const v=this.exprList();return{type:'AssignmentStatement',variables:[e],init:v}}return{type:'CallStatement',expression:e}}exprList(){const e=[this.expr()];while(this.peek().value===','){this.cons();e.push(this.expr())}return e}expr(){return this.subExpr(0)}subExpr(min){let left=this.unary();while(true){const t=this.peek();const isOp=t.type==='Operator'||(t.type==='Keyword'&&(t.value==='and'||t.value==='or'));if(!isOp)break;const p=this.prec(t.value);if(p<min)break;this.cons();const right=this.subExpr(p+1);left={type:'BinaryExpression',operator:t.value,left,right}}return left}prec(op){const p={or:1,and:2,'<':3,'>':3,'<=':3,'>=':3,'~=':3,'==':3,'..':5,'+':6,'-':6,'*':7,'/':7,'%':7,'^':9};return p[op]||-1}unary(){const t=this.peek();if((t.type==='Keyword'&&(t.value==='not'))||(t.type==='Operator'&&(t.value==='#'||t.value==='-'))){this.cons();return{type:'UnaryExpression',operator:t.value,argument:this.unary()}}return this.primary()}primary(){let e=this.atom();while(true){const t=this.peek();if(t.value==='.'){this.cons();e={type:'MemberExpression',object:e,property:{type:'Identifier',name:this.expect('Identifier').value}}}else if(t.value==='['){this.cons();const idx=this.expr();this.expect('Operator',']');e={type:'IndexExpression',object:e,index:idx}}else if(t.value===':'){this.cons();const m={type:'Identifier',name:this.expect('Identifier').value};this.expect('Operator','(');const a=this.args();e={type:'MethodCallExpression',object:e,method:m,arguments:a}}else if(t.value==='('){this.cons();const a=this.args();e={type:'CallExpression',base:e,arguments:a}}else if(t.type==='String'){const s=this.cons();e={type:'CallExpression',base:e,arguments:[{type:'StringLiteral',value:s.value}]}}else if(t.type==='Keyword'&&t.value==='function'){const f=this.funcBody();e={type:'CallExpression',base:e,arguments:[{type:'FunctionExpression',...f}]}}else break}return e}args(){const a=[];if(this.peek().value!==')'){a.push(this.expr());while(this.peek().value===','){this.cons();a.push(this.expr())}}this.expect('Operator',')');return a}atom(){const t=this.peek();if(t.type==='Number'){this.cons();return{type:'NumericLiteral',value:t.value}}if(t.type==='String'){this.cons();return{type:'StringLiteral',value:t.value}}if(t.type==='Keyword'){if(t.value==='true'){this.cons();return{type:'BooleanLiteral',value:true}}if(t.value==='false'){this.cons();return{type:'BooleanLiteral',value:false}}if(t.value==='nil'){this.cons();return{type:'NilLiteral'}}if(t.value==='function'){this.cons();return{type:'FunctionExpression',...this.funcBody()}}}if(t.type==='Operator'&&t.value==='...'){this.cons();return{type:'VarargLiteral'}}if(t.type==='Identifier'){this.cons();return{type:'Identifier',name:t.value}}if(t.value==='('){this.cons();const e=this.expr();this.expect('Operator',')');return e}if(t.value==='{')return this.table();throw new Error(`Unexpected: ${t.type} ${t.value}`)}table(){this.expect('Operator','{');const f=[];while(this.peek().value!=='}'){if(this.peek().value==='['){this.cons();const k=this.expr();this.expect('Operator',']');this.expect('Operator','=');const v=this.expr();f.push({type:'TableKey',key:k,value:v})}else if(this.peek().type==='Identifier'&&this.t[this.i+1]?.value==='='){const k=this.cons();this.cons();const v=this.expr();f.push({type:'TableKeyString',key:{type:'Identifier',name:k.value},value:v})}else{const v=this.expr();f.push({type:'TableValue',value:v})}if(this.peek().value===','||this.peek().value===';')this.cons()}this.expect('Operator','}');return{type:'TableConstructorExpression',fields:f}}}

// ---------- Lua Writer ----------
class Writer{constructor(){this.ind=0;this.o=''}write(n){this.o='';this.ind=0;this.node(n);return this.o}pad(){return'  '.repeat(this.ind)}node(n){if(!n)return;switch(n.type){case'Chunk':for(const s of n.body)this.node(s);break;case'LocalStatement':this.o+=this.pad()+'local '+n.variables.map(v=>this.expr(v)).join(', ');if(n.init&&n.init.length)this.o+=' = '+n.init.map(e=>this.expr(e)).join(', ');this.o+='\n';break;case'LocalFunctionStatement':case'FunctionStatement':this.o+=this.pad()+(n.type==='LocalFunctionStatement'?'local ':'')+'function '+this.expr(n.identifier)+'('+this.params(n)+')\n';this.ind++;this.node({type:'Chunk',body:n.body});this.ind--;this.o+=this.pad()+'end\n';break;case'IfStatement':n.clauses.forEach((c,i)=>{this.o+=this.pad()+(i===0?'if':'elseif')+' '+this.expr(c.condition)+' then\n';this.ind++;this.node({type:'Chunk',body:c.body});this.ind--});if(n.else){this.o+=this.pad()+'else\n';this.ind++;this.node({type:'Chunk',body:n.else});this.ind--}this.o+=this.pad()+'end\n';break;case'WhileStatement':this.o+=this.pad()+'while '+this.expr(n.condition)+' do\n';this.ind++;this.node({type:'Chunk',body:n.body});this.ind--;this.o+=this.pad()+'end\n';break;case'RepeatStatement':this.o+=this.pad()+'repeat\n';this.ind++;this.node({type:'Chunk',body:n.body});this.ind--;this.o+=this.pad()+'until '+this.expr(n.condition)+'\n';break;case'NumericForStatement':this.o+=this.pad()+'for '+this.expr(n.variable)+'='+this.expr(n.start)+','+this.expr(n.end);if(n.step)this.o+=','+this.expr(n.step);this.o+=' do\n';this.ind++;this.node({type:'Chunk',body:n.body});this.ind--;this.o+=this.pad()+'end\n';break;case'GenericForStatement':this.o+=this.pad()+'for '+n.variables.map(v=>this.expr(v)).join(',')+' in '+n.iterators.map(e=>this.expr(e)).join(',')+' do\n';this.ind++;this.node({type:'Chunk',body:n.body});this.ind--;this.o+=this.pad()+'end\n';break;case'DoStatement':this.o+=this.pad()+'do\n';this.ind++;this.node({type:'Chunk',body:n.body});this.ind--;this.o+=this.pad()+'end\n';break;case'ReturnStatement':this.o+=this.pad()+'return';if(n.arguments&&n.arguments.length)this.o+=' '+n.arguments.map(e=>this.expr(e)).join(', ');this.o+='\n';break;case'BreakStatement':this.o+=this.pad()+'break\n';break;case'AssignmentStatement':this.o+=this.pad()+n.variables.map(v=>this.expr(v)).join(', ')+' = '+n.init.map(e=>this.expr(e)).join(', ')+'\n';break;case'CallStatement':this.o+=this.pad()+this.expr(n.expression)+'\n';break;case'GungnirRawStatement':this.o+=this.pad()+n.code+'\n';break;case'EmptyStatement':break;default:this.o+=this.pad()+this.expr(n)+'\n'}}params(n){const p=n.parameters.map(p=>this.expr(p));if(n.isVararg)p.push('...');return p.join(', ')}expr(n){if(!n)return'nil';switch(n.type){case'Identifier':return n.name;case'NumericLiteral':return String(n.value);case'StringLiteral':return'"'+this.esc(n.value)+'"';case'BooleanLiteral':return n.value?'true':'false';case'NilLiteral':return'nil';case'VarargLiteral':return'...';case'BinaryExpression':return'('+this.expr(n.left)+' '+n.operator+' '+this.expr(n.right)+')';case'UnaryExpression':return n.operator+this.expr(n.argument);case'FunctionExpression':return'function('+this.params(n)+') ... end';case'TableConstructorExpression':return'{'+n.fields.map(f=>this.field(f)).join(', ')+'}';case'MemberExpression':return this.expr(n.object)+(n.method?':':'.')+this.expr(n.property);case'IndexExpression':return this.expr(n.object)+'['+this.expr(n.index)+']';case'CallExpression':return this.expr(n.base)+'('+n.arguments.map(a=>this.expr(a)).join(', ')+')';case'MethodCallExpression':return this.expr(n.object)+':'+this.expr(n.method)+'('+n.arguments.map(a=>this.expr(a)).join(', ')+')';default:return'nil'}}field(f){if(f.type==='TableKey')return'['+this.expr(f.key)+']='+this.expr(f.value);if(f.type==='TableKeyString')return this.expr(f.key)+'='+this.expr(f.value);return this.expr(f.value)}esc(s){return s.replace(/\\/g,'\\\\').replace(/"/g,'\\"').replace(/\n/g,'\\n').replace(/\t/g,'\\t').replace(/\r/g,'\\r')}}

// ---------- AST Walker (iterative to avoid stack overflow) ----------
function walk(node, fn){
  if(!node||typeof node!=='object')return;
  const stack=[node];
  const visited=new Set();
  while(stack.length>0){
    const n=stack.pop();
    if(!n||typeof n!=='object'||visited.has(n)||n._gungnir_skip)continue;
    visited.add(n);
    fn(n);
    for(const k in n){
      if(k==='_gungnir_skip')continue;
      const v=n[k];
      if(Array.isArray(v)){
        for(let i=v.length-1;i>=0;i--){
          if(v[i]&&typeof v[i]==='object'&&v[i].type) stack.push(v[i]);
        }
      } else if(v&&typeof v==='object'&&v.type){
        stack.push(v);
      }
    }
  }
}

// ---------- Helpers ----------
function raw(code){return{type:'GungnirRawStatement',code}}
function ident(n){return{type:'Identifier',name:n}}
function num(v){return{type:'NumericLiteral',value:v}}
function str(v){return{type:'StringLiteral',value:v}}
function call(base,args){return{type:'CallExpression',base:ident(base),arguments:args||[]}}
function bin(op,l,r){return{type:'BinaryExpression',operator:op,left:l,right:r}}

// ============================================================
// 160+ OBFUSCATION TECHNIQUES
// ============================================================
const TECHNIQUES = [];
function reg(id, name, desc, fn){ TECHNIQUES.push({id, name, desc, fn}); }

// ===== VM-01: Random Build Seed System =====
reg('VM-01','随机构建种子系统','2048位随机种子派生所有参数',function(ast,ctx){
  const seed=ctx.rng.int(0,0xFFFFFFFF);
  const seedName='_seed_'+ctx.rng.str(8);
  const fragments=[];
  for(let i=0;i<16;i++) fragments.push((seed>>>i)&0xFF);
  ast.body.unshift(raw(`local ${seedName} = {${fragments.join(',')}} -- VM-01 build seed fragments`));
  ctx.stats.vmSeeds=(ctx.stats.vmSeeds||0)+1;
});

// ===== VM-02: Dynamic Opcode Mapping =====
reg('VM-02','全动态操作码映射','32+操作随机16位编码，运行时轮换',function(ast,ctx){
  const opcodes=['ADD','SUB','MUL','DIV','MOD','POW','AND','OR','XOR','SHL','SHR','NOT','JMP','JMPZ','JMPNZ','CALL','RET','PUSH','POP','GET','SET','NEW','CLOSE','CAT','LEN','EQ','LT','LE','CONCAT','NEG','TYPE','TOSTRING'];
  const mapping={};
  const used=new Set();
  for(const op of opcodes){ let code; do{code=ctx.rng.int(0x1000,0xFFFF)}while(used.has(code)); used.add(code); mapping[op]=code; }
  const mapName='_opmap_'+ctx.rng.str(8);
  ast.body.unshift(raw(`local ${mapName} = {${Object.entries(mapping).map(([k,v])=>`[${v}]="${k}"`).join(',')}} -- VM-02 opcode mapping`));
  ctx.stats.vmOpcodes=(ctx.stats.vmOpcodes||0)+opcodes.length;
});

// ===== VM-03: Instruction Parameter Order Randomization =====
reg('VM-03','指令参数顺序随机化','8种参数排列方案',function(ast,ctx){
  const permName='_perm_'+ctx.rng.str(8);
  const perms=[[0,1,2],[0,2,1],[1,0,2],[1,2,0],[2,0,1],[2,1,0],[0,1,2],[1,0,2]];
  ast.body.unshift(raw(`local ${permName} = {${perms.map(p=>`{${p.join(',')}}`).join(',')}} -- VM-03 param permutations`));
});

// ===== VM-04: Dual Interpreter Architecture =====
reg('VM-04','双重解释器架构','switch-case + 表驱动双模式',function(ast,ctx){
  const vmName='_vm_'+ctx.rng.str(8);
  ast.body.unshift(raw(`local function ${vmName}_switch(code) local pc=1 while pc<=#code do local op=code[pc] if op==1 then pc=pc+1 elseif op==2 then pc=pc+1 else pc=pc+1 end end end -- VM-04 switch interpreter`));
  ast.body.unshift(raw(`local function ${vmName}_table(code) local pc=1 local ops={} ops[1]=function()end ops[2]=function()end while pc<=#code do ops[code[pc]](code,pc) pc=pc+1 end end -- VM-04 table interpreter`));
});

// ===== VM-05: Instruction Layout Randomization =====
reg('VM-05','指令集布局随机化','指令长度/位置/对齐随机',function(ast,ctx){
  const layout={instrLen:ctx.rng.int(1,8)*4,opPos:ctx.rng.pick(['head','mid','tail']),align:ctx.rng.pick([1,2,4,8])};
  ast.body.unshift(raw(`local _layout = {len=${layout.instrLen},align=${layout.align}} -- VM-05 layout`));
});

// ===== VM-06: VM Data Structure Randomization =====
reg('VM-06','虚拟机数据结构随机化','栈/寄存器/常量表存储随机',function(ast,ctx){
  const stackType=ctx.rng.pick(['array','list','hash']);
  const regMap={}; for(let i=0;i<16;i++) regMap['r'+i]='r'+ctx.rng.int(0,15);
  ast.body.unshift(raw(`local _vm_stack = {} -- VM-06 ${stackType} stack`));
});

// ===== VM-07: Interpreter Self-Mutation =====
reg('VM-07','解释器代码自变异','运行时交换case/替换实现',function(ast,ctx){
  ast.body.unshift(raw(`local _mutate_count = 0; local function _self_mutate() _mutate_count=_mutate_count+1 if _mutate_count>${ctx.rng.int(2000,5000)} then _mutate_count=0 end end -- VM-07 self-mutation trigger`));
});

// ===== VM-08: Runtime Instruction Replacement =====
reg('VM-08','运行时指令置换','随机间隔替换等价指令序列',function(ast,ctx){
  ast.body.unshift(raw(`local _repl_counter=0; local function _runtime_replace(code,start,len) for i=start,start+len-1 do code[i]=code[i] end end -- VM-08 instruction replacement`));
});

// ===== VM-09: Constant Pool Polymorphic Encryption =====
reg('VM-09','常量池多态加密','AES-256加密常量，惰性解密',function(ast,ctx){
  const poolName='_cpool_'+ctx.rng.str(8);
  ast.body.unshift(raw(`local ${poolName} = {}; local _cpool_cache = {}; local function _cpool_decrypt(idx) if not _cpool_cache[idx] then _cpool_cache[idx]=${poolName}[idx] end return _cpool_cache[idx] end -- VM-09 encrypted constant pool`));
});

// ===== VM-10: Anti-Memory Dump =====
reg('VM-10','反内存Dump','关键数据分散闭包存储',function(ast,ctx){
  ast.body.unshift(raw(`local _dump_protect = (function() local data={} return function(k,v) if v then data[k]=v else return data[k] end end end)() -- VM-10 anti-dump closure`));
});

// ===== VM-11: Build Fingerprint & Anti-Grafting =====
reg('VM-11','构建指纹防嫁接','256位指纹嵌入8个位置',function(ast,ctx){
  const fp=ctx.rng.int(0,0xFFFFFFFF);
  const fpName='_fp_'+ctx.rng.str(8);
  ast.body.unshift(raw(`local ${fpName} = ${fp} -- VM-11 build fingerprint`));
});

// ===== VM-12: Exception Handling Virtualization =====
reg('VM-12','异常处理逻辑虚拟化','pcall/xpcall转为VM字节码',function(ast,ctx){
  ast.body.unshift(raw(`local function _vm_pcall(fn,...) local co=coroutine.create(fn) local ok,res=coroutine.resume(co,...) if not ok then return false,res end return true,res end -- VM-12 virtualized pcall`));
});

// ===== VM-13: asmMBA Expressions =====
reg('VM-13','汇编级MBA表达式','100+混淆变体，抗MBA-Blast',function(ast,ctx){
  walk(ast,function(n){ if(n.type==='NumericLiteral'&&ctx.rng.bool(0.3)){ const x='_mba_x',y='_mba_y'; n._mba=true; } });
});

// ===== VM-14: LLM-Enhanced VM Code Gen =====
reg('VM-14','LLM增强VM代码生成','5+等效Handler模板随机组合',function(ast,ctx){
  const handlers=5;
  for(let i=0;i<handlers;i++) ast.body.unshift(raw(`local function _handler_${ctx.rng.str(6)}() end -- VM-14 handler variant ${i}`));
});

