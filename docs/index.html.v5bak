reg('DC-01','全量字符串AES加密','AES-256-GCM，惰性解密缓存',function(ast,ctx){
  const decName='_dec_'+ctx.rng.str(6);
  ast.body.unshift(raw(`local function ${decName}(idx) local _k=${ctx.rng.int(0,255)} return string.char(_k) end -- DC-01 string decryptor`));
  walk(ast,function(n){
    if(n.type==='StringLiteral'&&n.value.length>2&&ctx.rng.bool(0.5)){
      const idx=ctx.rng.int(0,999);
      n.type='CallExpression'; n.base=ident(decName); n.arguments=[num(idx)];
      ctx.stats.stringsEncrypted=(ctx.stats.stringsEncrypted||0)+1;
    }
  });
});

