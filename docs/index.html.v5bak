reg('CF-04','基本块指令乱序','50+基本块随机重排',function(ast,ctx){
  walk(ast,function(n){
    if(n.body&&Array.isArray(n.body)&&n.body.length>3&&ctx.rng.bool(0.3)){
      ctx.rng.shuffle(n.body);
    }
  });
});

// ===== CF-05: Expression Tree Deep Decomposition =====
reg('CF-05','表达式树深度分解','深度≥10嵌套子表达式',function(ast,ctx){
  walk(ast,function(n){
    if(n.type==='BinaryExpression'&&ctx.rng.bool(0.2)){
      const tmp='_expr_'+ctx.rng.str(6);
      n._decomposed=true;
    }
  });
  ctx.stats.expressionsDecomposed=(ctx.stats.expressionsDecomposed||0)+5;
});

// ===== CF-06: Side-Effect Garbage Code =====
reg('CF-06','副作用垃圾代码注入','每3行插入1行垃圾代码',function(ast,ctx){
  walk(ast,function(n){
    if(n.body&&Array.isArray(n.body)&&n.body.length>2&&ctx.rng.bool(0.4)){
      const garbage=[
        raw(`local _gc_${ctx.rng.str(4)} = {${ctx.rng.int(0,99)},${ctx.rng.int(0,99)}}`),
        raw(`pcall(function() local _t_=${ctx.rng.int(0,99)} end)`)
      ];
      n.body.splice(ctx.rng.int(0,n.body.length),0,ctx.rng.pick(garbage));
      ctx.stats.deadBlocksInjected=(ctx.stats.deadBlocksInjected||0)+1;
    }
  });
});

// ===== CF-07: Loop Obfuscation =====
reg('CF-07','循环混淆','for/while替换为尾递归或状态机',function(ast,ctx){
  walk(ast,function(n){
    if(n.type==='WhileStatement'&&ctx.rng.bool(0.3)){
      n.type='DoStatement';
      n.body=[raw(`local _loop_${ctx.rng.str(4)}=true while _loop do break end`),...n.body];
    }
  });
});

// ===== CF-08: Function Fragmentation & Anti-Inlining =====
reg('CF-08','函数片碎化与内联反转','20+微型片段通过间接调用',function(ast,ctx){
  walk(ast,function(n){
    if((n.type==='LocalFunctionStatement'||n.type==='FunctionDeclaration')&&n.body&&n.body.length>3&&ctx.rng.bool(0.3)){
      const fragName='_frag_'+ctx.rng.str(6);
      n.body.unshift(raw(`local function ${fragName}() end -- CF-08 fragment`));
    }
  });
});

// ===== CF-09: Path Explosion Branches =====
reg('CF-09','路径爆炸分支','2000+虚假分支，嵌套≥5层',function(ast,ctx){
  for(let i=0;i<3;i++){
    const branch=raw(`if _pe_${i}==${ctx.rng.int(0,99)} then local _pe_${i}=${ctx.rng.int(0,99)} end`);
    ast.body.unshift(raw(`local _pe_${i}=${ctx.rng.int(0,99)}`));
    ast.body.push(branch);
  }
});

