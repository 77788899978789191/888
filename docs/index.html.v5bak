      const parts=[]; const s=n.value;
      for(let i=0;i<s.length;i+=2) parts.push('"'+s.substring(i,i+2)+'"');
      n.type='CallExpression'; n.base={type:'MemberExpression',object:ident('table'),property:ident('concat')}; n.arguments=[{type:'TableConstructorExpression',fields:parts.map(p=>({type:'TableValue',value:{type:'StringLiteral',value:eval(p)}}))}];
