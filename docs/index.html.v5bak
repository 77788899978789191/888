// ===== SC-05: Function Wrapping & Scope Isolation =====
reg('SC-05','函数整体包装与作用域隔离','两层匿名函数包裹',function(ast,ctx){
  walk(ast,function(n){
    if((n.type==='LocalFunctionStatement'||n.type==='FunctionDeclaration')&&n.body&&ctx.rng.bool(0.3)){
      // Check if body contains standalone 'end' raw statements (would break anonymous function)
      let hasStandaloneEnd=false;
      for(const s of n.body){
        if(s.type==='GungnirRawStatement'&&s.code&&s.code.trim()==='end'){
          hasStandaloneEnd=true; break;
        }
      }
      if(!hasStandaloneEnd){
        n.body=[raw(`return (function(...) `),...n.body,raw(`end)(...)`)];
      }
    }
  });
});

