reg('VM-17','双层VM堆叠架构','反序列化VM + 执行VM串联',function(ast,ctx){
  ast.body.unshift(raw(`local function _deser_vm(enc) return enc end; local function _exec_vm(code) local pc=1 while pc<=#code do pc=pc+1 end end -- VM-17 dual-VM stacking`));
});

